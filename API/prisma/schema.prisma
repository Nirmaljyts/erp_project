datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  HR
  MANAGER
  EMPLOYEE
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(EMPLOYEE)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // --- MANAGER <-> EMPLOYEES RELATION ---
  managerId Int?
  manager   User?     @relation("ManagerEmployees", fields: [managerId], references: [id])
  employees User[]    @relation("ManagerEmployees")

  // --- LEAVE RELATIONS ---
  leaveRequests  Leave[] @relation("UserLeaves")
  leaveApprovals Leave[] @relation("ReviewerLeaves")

  // --- PROJECT RELATIONS ---
  projectsManaged Project[]         @relation("ProjectManager")
  projects        ProjectEmployee[]

  // --- OTHERS ---
  otpCodes        OtpCode[]
}

model Client {
  id          Int       @id @default(autoincrement())
  name        String
  email       String
  phone       String?
  contactedBy String?
  deletedAt   DateTime? // <--- soft delete
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  status      String    @default("ACTIVE")
  startDate   DateTime?
  endDate     DateTime?
  deletedAt   DateTime? // <--- soft delete
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  managerId Int?
  manager   User? @relation("ProjectManager", fields: [managerId], references: [id])

  employees ProjectEmployee[]
}

model ProjectEmployee {
  id         Int       @id @default(autoincrement())
  projectId  Int
  employeeId Int
  startDate  DateTime?
  endDate    DateTime?
  deletedAt  DateTime? // <--- soft delete (optional but useful)

  project  Project @relation(fields: [projectId], references: [id])
  employee User    @relation(fields: [employeeId], references: [id])

  @@unique([projectId, employeeId])
}

model Holiday {
  id         Int       @id @default(autoincrement())
  date       DateTime  @db.Date
  name       String
  country    String?   @default("United Kingdom")
  isOptional Boolean   @default(false)
  deletedAt  DateTime? // <--- soft delete
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([date, name])
}

model OtpCode {
  id        Int       @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean   @default(false)
  deletedAt DateTime? // <--- soft delete (optional; probably unnecessary but added for consistency)
  createdAt DateTime  @default(now())

  user   User? @relation(fields: [userId], references: [id])
  userId Int?
}

model Leave {
  id           Int       @id @default(autoincrement())
  userId       Int
  reviewerId   Int?
  type         String
  startDate    DateTime
  endDate      DateTime
  reason       String?
  status       String    @default("PENDING")
  decidedAt    DateTime?
  approvedById Int?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  // Relations
  user     User  @relation("UserLeaves", fields: [userId], references: [id])
  reviewer User? @relation("ReviewerLeaves", fields: [reviewerId], references: [id])
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  WFH
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
